# ==============================================================================
# MANA GRAMAM — Environment Configuration
# Village Development Transparency System
# ==============================================================================

# Supabase Project URL and Public Anon Key
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Target Village ID (matching villages table primary key)
# Default seed village is Peddapalli:
VITE_VILLAGE_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# Application details
VITE_APP_TITLE="Mana Gramam"
VITE_APP_TAGLINE="Every Work Visible. Every Rupee Accountable."
